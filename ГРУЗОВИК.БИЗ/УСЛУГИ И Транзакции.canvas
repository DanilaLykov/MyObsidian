		{"id":"b5c8a009105fd92f","type":"text","text":"**Type (тип)**\nTYPE_ADD_BY_CARD (картой)\nTYPE_ADD_BY_INVOICE (выставление счета)\nTYPE_CHARGE(когда действие выполнено администратором)\n","x":-570,"y":80,"width":250,"height":220},
